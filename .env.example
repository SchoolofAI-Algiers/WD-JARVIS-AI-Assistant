GEMINI_API_KEY="your_gemini_api_key"
GROQ_API_KEY="your_groq_api_key"
VOICE_STT_DEVICE="cpu"
VOICE_STT_MODEL_SIZE="base"
VOICE_TTS_PROVIDERS=piper,pyttsx3
VOICE_TTS_PROVIDER_TIMEOUT_S=30
VOICE_TTS_TIMEOUT_S=40

# --- RAG ----

WEAVIATE_MODE=cloud              
WEAVIATE_URL=https://your-cluster.weaviate.cloud  #rest API 
WEAVIATE_API_KEY=your-weaviate-api-key
RAG_COLLECTION=SoaiChunk

HF_TOKEN=hf_your_token
RAG_EMBEDDING_MODEL=google/embeddinggemma-300m
RAG_EMBEDDING_DIM=768             

RAG_TOP_K=3
RAG_ALPHA=0.5                       #0=keywords only, 1=vectors only
RAG_MIN_SIMILARITY=0.35
